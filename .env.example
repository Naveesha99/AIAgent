# Copy the needed values to an untracked local environment file.
# Never put real credentials in this file or commit local secrets.

# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATASET_STORAGE_DIR=data/datasets
DATASET_TTL_HOURS=24
DATA_QUALITY_SAMPLE_LIMIT=5
ANALYTICS_MAX_RESULT_ROWS=1000
ANALYTICS_MAX_GROUPS=100
ANALYTICS_MAX_VALUE_FREQUENCIES=10

# LLM provider (backend only; never expose these values to the frontend)
# Set LLM_PROVIDER=mock for deterministic local responses without a Gemini key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30
LLM_RETRY_JITTER_RATIO=0.2
LLM_MOCK_SCENARIO=success
LLM_MOCK_MODEL=mock-deterministic

# Execution is disabled by default; enabling it uses the restricted Docker engine.
EXECUTION_ENABLED=false
EXECUTION_MAX_TIMEOUT_SECONDS=30
EXECUTION_MAX_CODE_SIZE_BYTES=50000
EXECUTION_MAX_STDOUT_BYTES=100000
EXECUTION_MAX_STDERR_BYTES=50000
EXECUTION_MAX_RESULT_BYTES=2000000
EXECUTION_MAX_RESULT_ROWS=1000

# Docker sandbox policy and resource limits.
# Safe defaults; execution requests cannot override these server-side values.
SANDBOX_WORKER_IMAGE=ai-data-analyst-worker:dev
SANDBOX_NETWORK_MODE=none
SANDBOX_READ_ONLY_ROOT=true
SANDBOX_SECCOMP_PROFILE=default
SANDBOX_MEMORY_LIMIT=512m
# Optional. Defaults to the memory limit, which disables container swap.
# Must be greater than or equal to SANDBOX_MEMORY_LIMIT when set.
# SANDBOX_MEMORY_SWAP_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMP_SIZE=64m
SANDBOX_EXECUTION_TIMEOUT_SECONDS=30
SANDBOX_MAX_STDOUT_BYTES=100000
SANDBOX_MAX_STDERR_BYTES=50000
