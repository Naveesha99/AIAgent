# Backend application configuration.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_CSV_COLUMNS=200
MAX_CSV_ROWS=100000
MAX_CSV_FIELD_SIZE=1048576
MAX_CSV_VALIDATION_LINES=200000
DATA_QUALITY_SAMPLE_LIMIT=5
ANALYTICS_MAX_RESULT_ROWS=1000
ANALYTICS_MAX_GROUPS=100
ANALYTICS_MAX_VALUE_FREQUENCIES=10
DATASET_STORAGE_DIR=data/datasets
DATASET_TTL_HOURS=24
# LLM provider: gemini for real requests, mock for deterministic local use.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=30
LLM_RETRY_JITTER_RATIO=0.2
# Mock mode only. No Gemini API key or external request is required.
LLM_MOCK_SCENARIO=success
LLM_MOCK_MODEL=mock-deterministic

# Execution is contract-only in Phase 5.1; no code execution path is enabled.
EXECUTION_ENABLED=false
EXECUTION_MAX_TIMEOUT_SECONDS=30
EXECUTION_MAX_CODE_SIZE_BYTES=50000
EXECUTION_MAX_STDOUT_BYTES=100000
EXECUTION_MAX_STDERR_BYTES=50000
