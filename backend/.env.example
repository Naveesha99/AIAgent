# Backend application configuration.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_CSV_COLUMNS=200
MAX_CSV_ROWS=100000
MAX_CSV_FIELD_SIZE=1048576
MAX_CSV_VALIDATION_LINES=200000
DATA_QUALITY_SAMPLE_LIMIT=5
ANALYTICS_MAX_RESULT_ROWS=1000
ANALYTICS_MAX_GROUPS=100
ANALYTICS_MAX_VALUE_FREQUENCIES=10
DATASET_STORAGE_DIR=data/datasets
DATASET_TTL_HOURS=24
# Optional Google Gemini provider. Keep the API key on the backend only.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
